+def port_closed(connection=socket.create_connection):
+    try:
+        client = connection(('127.0.0.1', 16333), timeout=1)
+    except ConnectionRefusedError:
+        return {'pointInTimeConnectionRefused': True, 'sharedStoreAbsenceProven': False}
+    except OSError:
