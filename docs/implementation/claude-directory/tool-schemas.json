  {
    "name": "log_watch",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Stable ID for this exact action. Reuse it for retries; use a different ID for a new action."
        },
        "title_id": {
          "description": "Use this ID when available; it takes precedence over title_name and year.",
          "type": "string",
          "pattern": "^(movie|show):[1-9]\\d{0,9}$"
        },
        "title_name": {
          "description": "Required only without title_id. Ignored when an ID is supplied.",
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "year": {
          "description": "Optional name disambiguation, used only without title_id.",
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "season": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "episode": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "episode_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "whole_season": {
          "type": "boolean"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "items": {
          "description": "Up to 50 titles in one call, in place of title_id or title_name. Each item takes title_id, or title_name with an optional year, plus this tool's fields; a field given at the top level applies to every item that leaves it out.",
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title_id": {
                "description": "Use this ID when available; it takes precedence over title_name and year.",
                "type": "string",
                "pattern": "^(movie|show):[1-9]\\d{0,9}$"
              },
              "title_name": {
                "description": "Required only without title_id. Ignored when an ID is supplied.",
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              },
              "year": {
                "description": "Optional name disambiguation, used only without title_id.",
                "type": "integer",
                "minimum": 1800,
                "maximum": 2100
              },
              "season": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "episode": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "episode_end": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "whole_season": {
                "type": "boolean"
              },
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "action_id"
      ],
      "additionalProperties": false
    }
