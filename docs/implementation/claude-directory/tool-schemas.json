  {
    "name": "get_title",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "title_id": {
          "type": "string",
          "pattern": "^(movie|show):[1-9]\\d{0,9}$"
        },
        "title_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "include": {
          "default": [
            "cast",
            "scores",
            "analysis"
          ],
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cast",
              "scores",
              "analysis",
              "seasons",
              "episodes"
            ]
          }
        },
        "season_number": {
          "description": "Displayed season: 0 for Specials; -1 for Additional episodes in a reviewed presentation.",
          "type": "integer",
          "minimum": -1,
          "maximum": 10000
        },
        "episode_cursor": {
          "type": "string",
          "pattern": "^offset:[0-9]{1,8}$"
        },
        "episode_limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "additionalProperties": false
    }
  },
