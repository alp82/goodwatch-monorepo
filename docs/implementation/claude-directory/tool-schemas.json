[
  {
    "name": "search_titles",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "all",
            "movie",
            "show"
          ]
        },
        "genres": {
          "description": "Exact genre names from get_discover_filters; a single name or an array, matching any selected genre.",
          "anyOf": [
            {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          ]
        },
        "min_year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "max_year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "min_runtime": {
          "description": "Inclusive minutes; movie duration or usual episode length for shows. Unknown runtimes do not pass.",
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_runtime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "minimum_score": {
          "description": "GoodWatch score, 0\u2013100; inclusive minimum.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "on_my_services": {
          "description": "Default false (everywhere). Uses saved country and services. Without saved services this does not narrow, as on the site.",
          "type": "boolean"
        },
        "providers": {
          "description": "Specific provider IDs from get_discover_filters, in your saved country. Matches any selected provider; mutually exclusive with on_my_services=true.",
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 999999999
          }
        },
        "anime": {
          "type": "string",
          "enum": [
            "any",
            "only",
            "none"
          ]
        },
        "moods": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "funny",
              "feelgood",
              "romance",
              "action",
              "scary",
              "crime",
              "mind",
              "heavy",
              "worlds",
              "history",
              "growing"
            ]
          }
        },
        "themes": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "crime",
              "mystery",
              "war",
              "politics",
              "true",
              "history",
              "growing",
              "family",
              "mind",
              "showbiz",
              "sports",
              "money",
              "future",
              "fantasy"
            ]
          }
        },
        "styles": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "animated",
              "documentary",
              "spectacle",
              "stylized",
              "music",
              "slow",
              "fast",
              "talky",
              "nonlinear",
              "graphic"
            ]
          }
        },
        "minimum_match": {
          "description": "GoodWatch taste match threshold; does not narrow when taste is unavailable, as on the site.",
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 70
            },
            {
              "type": "number",
              "const": 80
            },
            {
              "type": "number",
              "const": 90
            }
          ]
        },
        "released": {
          "type": "string",
          "enum": [
            "any",
            "recent",
            "2010s",
            "2000s",
            "before2000"
          ]
        },
        "age_limit": {
          "description": "Uses the saved country's age-rating ladder, when available.",
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "hide_content": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "violence",
              "sex",
              "disturbing",
              "language",
              "drugs"
            ]
          }
        },
        "show_content": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "violence",
              "sex",
              "disturbing",
              "language",
              "drugs"
            ]
          }
        },
        "order": {
          "description": "Default For you (popular with the site's taste adjustment). Other orders disable that adjustment unless for_you=true is explicitly supplied. Match uses the site's Best match order.",
          "type": "string",
          "enum": [
            "for_you",
            "popularity",
            "newest",
            "score",
            "match"
          ]
        },
        "query": {
          "default": "",
          "description": "A title name or descriptive query. Blank queries run discovery.",
          "type": "string",
          "maxLength": 120
        },
        "ranked": {
          "default": false,
          "description": "Use an optional smarter match for descriptive queries instead of name lookup. Costs one of 20 daily attempts unless cached; paging is free.",
          "type": "boolean"
        },
        "cursor": {
          "type": "string",
          "pattern": "^(offset:[0-9]{1,8}|ranked:[a-f0-9]{32}:[0-9]{1,8})$"
        },
        "limit": {
          "default": 40,
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "for_you": {
          "description": "Smarter matches: use the site's For you ordering (default true). Keep unchanged when paging; a cursor inherits its original filters.",
          "type": "boolean"
        },
        "exclude_seen": {
          "description": "Default false: include seen titles. True uses the site's Not seen yet rule: exclude rated, watched, in-progress, on-hold, dropped and quiz-skipped titles. Apply natively before paging.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
