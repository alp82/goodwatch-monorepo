index 00000000..f441e6f4
--- /dev/null
+++ b/goodwatch-webapp/app/entry.server.tsx
@@ -0,0 +1,92 @@
+// MEASUREMENT BUILD ONLY. GW_ENTRY=default is Remix's default Node entry; GW_ENTRY=fix is the entry of the fix
+// (HtmlStream and a cleared abort timer). Both record marks for the render profile.
+import { PassThrough } from "node:stream"
+
+import type { AppLoadContext, EntryContext } from "@remix-run/node"
+import { createReadableStreamFromReadable } from "@remix-run/node"
+import { RemixServer } from "@remix-run/react"
+import { isbot } from "isbot"
+import { renderToPipeableStream } from "react-dom/server"
+import { HtmlStream } from "~/server/html-stream.server"
+
+const ABORT_DELAY = 5_000
+
+type Gw = { mark(name: string): void; add(name: string, value: number): void }
+const gw = (): Gw | undefined => (globalThis as { __gw?: Gw }).__gw
+
+// Wrap every route's loader once, so each request records when each loader started and ended.
+void import("virtual:remix/server-build").then((build) => {
+	for (const [id, route] of Object.entries(build.routes) as [string, { module: Record<string, unknown> }][]) {
+		const loader = route.module.loader as ((args: unknown) => unknown) | undefined
+		if (typeof loader !== "function") continue
+		route.module = {
+			...route.module,
+			loader: async (args: unknown) => {
+				gw()?.mark(`loader_start:${id}`)
+				try {
+					return await loader(args)
+				} finally {
+					gw()?.mark(`loader_end:${id}`)
+				}
+			},
+		}
+	}
+})
+
+export default function handleRequest(
+	request: Request,
+	responseStatusCode: number,
+	responseHeaders: Headers,
+	remixContext: EntryContext,
+	_loadContext: AppLoadContext,
+) {
+	const waitForAll = isbot(request.headers.get("user-agent") ?? "") || remixContext.isSpaMode
+	const fix = process.env.GW_ENTRY === "fix"
+	gw()?.mark("render_start")
+	return new Promise((resolve, reject) => {
+		let shellRendered = false
+		let status = responseStatusCode
+		let chunks = 0
+		let bytes = 0
+		const abortTimer = setTimeout(() => abort(), ABORT_DELAY)
+		const send = () => {
+			shellRendered = true
+			gw()?.mark(waitForAll ? "all_ready" : "shell_ready")
+			const body = fix ? new HtmlStream() : new PassThrough()
+			if (fix) body.once("close", () => clearTimeout(abortTimer))
+			body.on("data", (chunk: Buffer) => {
+				chunks++
+				bytes += chunk.length
+			})
+			body.on("end", () => {
+				gw()?.add("react_chunks", chunks)
+				gw()?.add("react_bytes", bytes)
+				gw()?.mark("react_stream_end")
+			})
+			responseHeaders.set("Content-Type", "text/html")
+			resolve(new Response(createReadableStreamFromReadable(body), { headers: responseHeaders, status }))
+			pipe(body)
+			gw()?.mark("pipe_returned")
+		}
+		const { pipe, abort } = renderToPipeableStream(
+			<RemixServer context={remixContext} url={request.url} abortDelay={ABORT_DELAY} />,
+			{
+				onShellReady() {
+					if (!waitForAll) send()
+				},
+				onAllReady() {
+					if (waitForAll) send()
+					else gw()?.mark("all_ready")
+				},
+				onShellError(error: unknown) {
+					clearTimeout(abortTimer)
+					reject(error)
+				},
+				onError(error: unknown) {
+					status = 500
+					if (shellRendered) console.error(error)
+				},
+			},
+		)
+	})
+}
