  "raw_code": "import json,math\nfrom f.db.mongodb import init_mongodb,close_mongodb\nfrom f.dna.models import DnaMovie,DnaTv,DNAAnalysis,CoreScores\nfrom f.dna.generate.spend_pause import SpendPause\n\ndef main():\n init_mongodb()\n try:\n  records=[]\n  for cls,tmdb_id in [(DnaMovie,603),(DnaTv,64230)]:\n   e=cls.objects.get(tmdb_id=tmdb_id)\n   DNAAnalysis.model_validate_json(json.dumps(e.dna),strict=True)\n   scores=e.dna['fingerprint']['scores'];highlights=e.dna['fingerprint']['highlight_keys'];tags=e.dna['essence_tags']\n   assert set(scores)==set(CoreScores.model_fields)\n   assert all(type(v) is int and 0<=v<=10 for v in scores.values())\n   assert 4<=len(highlights)<=8 and len(set(highlights))==len(highlights)\n   assert not set(highlights)-set(scores), f'Invalid highlights on {e.original_title}'\n   assert 8<=len(tags)<=10 and len(set(tags))==len(tags)\n   assert len(e.vector_essence_text)==768 and all(math.isfinite(v) for v in e.vector_essence_text)\n   assert e.vector_fingerprint==[float(scores[k]) for k in CoreScores.model_fields]\n   assert e.llm_model_name in ['openrouter:qwen/qwen3.8-flash@alibaba','openrouter:qwen/qwen3.7-flash@alibaba']\n   assert not e.is_selected and e.failed_at is None and e.error_message is None\n   records.append({'id':str(e.id),'tmdb_id':e.tmdb_id,'title':e.original_title,'model':e.llm_model_name,'dna':e.dna,'essence_vector_length':len(e.vector_essence_text),'fingerprint_length':len(e.vector_fingerprint),'selected_at':str(e.selected_at),'updated_at':str(e.updated_at)})\n  assert not SpendPause().is_active()\n  return {'verified':True,'records':records,'pause_active':False}\n finally:\n  close_mongodb()\n",
