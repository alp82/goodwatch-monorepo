# Copy to config.env. This is Bash syntax, even when your interactive shell is fish.
# Every setting is optional. Quoted values preserve spaces, semicolons, and pipes.
# SSH jump destination. Empty means direct SSH. Never commit its value.
# BENCH_SSH_JUMP=''
# BENCH_SSH_USER='root'
# BENCH_GENERATOR='10.0.0.32'
# BENCH_TARGET_URL='https://goodwatch.app'
# BENCH_RESOLVE_IP='10.0.0.21'
# BENCH_REMOTE_DIR='/opt/goodwatch-benchmark'
# BENCH_K6_IMAGE='grafana/k6:1.8.1'
# BENCH_METRIC_HOSTS='10.0.0.21:target:coolify-proxy+gk4owk8'
# Example with data hosts. The generator is always added automatically.
# Crate is 10.0.0.11 to .13, Redis .14 to .16, Mongo .17 to .19, Qdrant .20.
# BENCH_METRIC_HOSTS='10.0.0.21:target:coolify-proxy+gk4owk8,10.0.0.11:data,10.0.0.14:data,10.0.0.17:data,10.0.0.20:data'
# BENCH_METRIC_INTERVAL=5
# BENCH_ALLOW_ABOVE_500=0
# BENCH_NO_COUNTDOWN=0
# BENCH_KEEP_REMOTE=0

# k6 defaults. Command options override rate and cache settings.
# RATE_START=5
# RATE_STEP=5
# RATE_MAX=5
# STEP_DURATION=10
# RAMP_SECONDS=5
# PRE_VUS=max(20,RATE_MAX)       # Derived integer; do not copy this expression.
# MAX_VUS=max(50,RATE_MAX*4)     # Derived integer.
# CACHE_MODE='warm'
# COOKIE='gw_browser=1'         # An explicit empty string disables the header.
# COOKIE_TEMPLATE='gw_browser=1; bench_visitor={id}'
# ACCEPT_LANGUAGE='en-US,en;q=0.9'
# ACCEPT_LANGUAGES='en-US,en;q=0.9|de-DE,de;q=0.9,en;q=0.8|fr-FR,fr;q=0.9|es-ES,es;q=0.9|pt-BR,pt;q=0.9'
# CACHE_BUST_QUERY=0
# SEQUENTIAL=0
# PREWARM_MAX=200
# SHARE_LIST_PATH=''
# SHARE_LIST_OG_PATH=''
# BROWSER_UA='Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Mobile Safari/537.36'
# BOT_UA='facebookexternalhit/1.1' # Recognizable crawler token, without an external hostname.
# ACCEPT_ENCODING='br, gzip'
# REQUEST_TIMEOUT='30s'
# ABORT_ERROR_RATE=0.02
# ABORT_P95_MS=3000
# ABORT_DELAY='10s'
# ABORT_DROPPED=ceil(RATE_MAX*STEP_DURATION*0.05) # Global count; derived integer.
# Direct k6 only. bench.sh sets these from its options and BENCH_* settings.
# URLS_FILE='/work/urls.json'
# TARGET_URL='https://goodwatch.app'
# RESOLVE_IP=''                # bench.sh private path sets BENCH_RESOLVE_IP.
# OUT_DIR='/work'

# Lighthouse container inputs.
# LH_URLS_FILE='/work/urls.txt' # bench.sh mounts the --urls file here.
# LH_RUNS=3
# LH_OUT='/out'                # bench.sh mounts the result directory here.
# LH_EXTRA_CHROME_FLAGS=''
# Requests that Lighthouse's browser must not send, separated by spaces. The page posts to
# /api/og-image-warm after each view, which starts a render on the server.
# LH_BLOCKED_URL_PATTERNS='*/api/og-image-warm*'
# LH_RESOLVE_IP=''             # bench.sh private path sets BENCH_RESOLVE_IP.
