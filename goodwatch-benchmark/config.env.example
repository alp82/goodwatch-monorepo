# Copy to config.env. This is Bash syntax, even when your interactive shell is fish.
# Every setting is optional. Quoted values preserve spaces, semicolons, and pipes.
# SSH jump destination. Empty means direct SSH. Never commit its value.
# BENCH_SSH_JUMP=''
# BENCH_SSH_USER='root'
# BENCH_GENERATOR='10.0.0.32'
# BENCH_TARGET_URL='https://goodwatch.app'
# BENCH_STATIC_HOST='static.example.com'
# BENCH_RESOLVE_IP='10.0.0.21'
# Skip certificate checks, for one instance behind another host's proxy (see "One instance" in the README).
# BENCH_INSECURE_TLS=0
# BENCH_REMOTE_DIR='/opt/goodwatch-benchmark'
# BENCH_K6_IMAGE='grafana/k6:1.8.1'
# BENCH_METRIC_HOSTS='10.0.0.21:target:coolify-proxy+gk4owk8'
# Example with data hosts. The generator is always added automatically.
# Crate is 10.0.0.11 to .13, Redis .14 to .16, Mongo .17 to .19, Qdrant .20.
# BENCH_METRIC_HOSTS='10.0.0.21:target:coolify-proxy+gk4owk8,10.0.0.11:data,10.0.0.14:data,10.0.0.17:data,10.0.0.20:data'
# Search roles that ./bench.sh smoke also checks: host:container name, separated by commas. The names are those in
# goodwatch-search/docker-compose.yml. Empty means that the smoke check skips them.
# SMOKE_SEARCH_ROLES='vector1:goodwatch-search-a,vector1:goodwatch-search-b'
# BENCH_METRIC_INTERVAL=5
# BENCH_ALLOW_ABOVE_500=0
# BENCH_NO_COUNTDOWN=0
# BENCH_KEEP_REMOTE=0
# Also read the webapp's /metrics, Qdrant's counters, and CPU per thread on the serving host.
# BENCH_WEBAPP_PROBE=0
# Further hosts with a webapp instance behind the balanced route, read the same way (private addresses, commas).
# BENCH_WEBAPP_PROBE_EXTRA='10.0.0.20'

# k6 defaults. Command options override rate and cache settings.
# RATE_START=5
# RATE_STEP=5
# RATE_MAX=5
# STEP_DURATION=10
# RAMP_SECONDS=5
# RATE_LIST=''                  # Explicit plateaus, such as '2,4,6,10,15'. Same as --rates.
# ONLY_ROUTES=''                # Subset of the URL set, such as 'home,title_movie:browser'. Same as --routes.
# PRE_VUS=max(20,RATE_MAX)       # Derived integer; do not copy this expression.
# MAX_VUS=max(50,RATE_MAX*4)     # Derived integer.
# CACHE_MODE='warm'
# SCENARIO='requests'           # Or 'page-view': one iteration is one visitor with a whole page view. Same as --scenario.
# PAGE_FILES='page'             # Or 'origin': send captured static files to the site. Page-view scenario only.
# CONNECTIONS='reuse'           # 'new' opens a connection per iteration. The page-view scenario defaults to 'new'.
# CACHE_IDENTITY=''             # GW-Cache-Identity for page requests. The page-view scenario defaults to 'anon;US;en'.
# CAPTURE_SETTLE=10             # Seconds the page-view capture waits after the load event.
# SLICE_SECONDS=0               # Page-view scenario: percentiles per slice of this length, for a long plateau.
# ABORT_PAGE_P95_MS=10000       # Page-view scenario: stop when a step's whole page view p95 is above this.
# COOKIE='gw_browser=1'         # An explicit empty string disables the header.
# COOKIE_TEMPLATE='gw_browser=1; bench_visitor={id}'
# ACCEPT_LANGUAGE='en-US,en;q=0.9'
# ACCEPT_LANGUAGES='en-US,en;q=0.9|de-DE,de;q=0.9,en;q=0.8|fr-FR,fr;q=0.9|es-ES,es;q=0.9|pt-BR,pt;q=0.9'
# CACHE_BUST_QUERY=0
# SEQUENTIAL=0
# PREWARM_MAX=200
# SHARE_LIST_PATH=''
# SHARE_LIST_OG_PATH=''
# BROWSER_UA='Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Mobile Safari/537.36'
# BOT_UA='facebookexternalhit/1.1' # Recognizable crawler token, without an external hostname.
# ACCEPT_ENCODING='br, gzip'
# REQUEST_TIMEOUT='30s'
# ABORT_ERROR_RATE=0.02
# ABORT_P95_MS=3000
# ABORT_DELAY='10s'
# ABORT_DROPPED=ceil(RATE_MAX*STEP_DURATION*0.05) # Global count; derived integer.
# Direct k6 only. bench.sh sets these from its options and BENCH_* settings.
# URLS_FILE='/work/urls.json'
# TARGET_URL='https://goodwatch.app'
# RESOLVE_IP=''                # bench.sh private path sets BENCH_RESOLVE_IP.
# OUT_DIR='/work'

# Lighthouse container inputs.
# LH_URLS_FILE='/work/urls.txt' # bench.sh mounts the --urls file here.
# LH_RUNS=3
# LH_OUT='/out'                # bench.sh mounts the result directory here.
# LH_EXTRA_CHROME_FLAGS=''
# CPU slowdown of Lighthouse's simulation (--throttling.cpuSlowdownMultiplier). 2.7 is calibrated for the generator,
# whose CPU benchmark reads about 1,170. Lighthouse's own default is 4. See "CPU slowdown" in the README.
# LH_CPU_SLOWDOWN=2.7
# Requests that Lighthouse's browser must not send, separated by spaces. No landing page sends a request that
# changes server state today. The default is left from the warm request that every page view sent until
# October 4, 2026, and stays as a guard.
# LH_BLOCKED_URL_PATTERNS='*/api/og-image-warm*'
# LH_RESOLVE_IP=''             # bench.sh private path sets BENCH_RESOLVE_IP.

# Tap test (./bench.sh tap). Command options override these.
# TAP_RUNS=5                    # Measurements per page, control, and mode. Same as --runs.
# TAP_CONTROLS=''               # Such as 'cast_next,related_tab'. Empty means all. Same as --controls.
# TAP_MODES=''                  # 'early', 'scroll', or both. Same as --modes.
# TAP_TIMEOUT_MS=5000           # A tap without its effect after this time is lost. Same as --timeout.
# TAP_SETTLE_MS=3000            # Scroll mode: wait between the load event and the first drag. Same as --settle.
# TAP_CPU=4                     # Slowdown of the real CPU. Lighthouse's default for a phone. Same as --cpu.
# TAP_NETWORK='none'            # Or 'slow4g'. Same as --network.
# TAP_READY_WAIT_MS=10000       # After a lost tap: how long to wait for script to take the control over.
# TAP_SCROLL_SPEED=8000         # Pace of a drag in CSS pixels per second.
# TAP_BLOCKED_URL_PATTERNS='*/api/og-image-warm* */api/update-* */api/poster-impressions*'
