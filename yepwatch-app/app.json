{
  "expo": {
    "name": "YepWatch",
    "slug": "yepwatch",
    "owner": "alperortac",
    "extra": {
      "eas": {
        "projectId": "0772c2db-91d8-4862-80eb-1d816f243072"
      }
    },
    "version": "0.1.0",
    "scheme": "yepwatch",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.yepwatch.foundation"
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "dev.yepwatch.foundation"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "YepWatch",
      "description": "Choose something to watch, together."
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    }
  }
}
