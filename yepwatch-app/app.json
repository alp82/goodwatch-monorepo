{
  "expo": {
    "name": "YepWatch",
    "slug": "yepwatch",
    "owner": "alperortac",
    "extra": {
      "eas": {
        "projectId": "0772c2db-91d8-4862-80eb-1d816f243072"
      }
    },
    "version": "0.1.0",
    "scheme": "yepwatch",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.yepwatch.foundation"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "dev.yepwatch.foundation",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141414"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "YepWatch",
      "description": "Choose something to watch, together.",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070707",
          "image": "./assets/splash-y.png",
          "imageWidth": 44,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "backgroundColor": "#070707",
    "icon": "./assets/icon.png"
  }
}
