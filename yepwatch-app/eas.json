{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "24.15.0",
      "env": {
        "APP_VARIANT": "production",
        "APP_BUILD_NUMBER": "16",
        "EXPO_PUBLIC_API_ORIGIN": "https://yepwatch.com",
        "EXPO_PUBLIC_APP_ORIGIN": "https://yepwatch.com",
        "EXPO_PUBLIC_WS_ORIGIN": "wss://yepwatch.com",
        "EXPO_PUBLIC_ENABLE_FIXTURES": "false",
        "EXPO_PUBLIC_GUEST_ONLY": "false",
        "NPM_CONFIG_INSTALL_LINKS": "true"
      },
      "environment": "production"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "developmentClient": false,
      "env": {
        "APP_VARIANT": "preview"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "ios": {
        "simulator": true
      },
      "environment": "preview",
      "channel": "beta-preview"
    },
    "production": {
      "extends": "base",
      "env": {
        "APP_VERSION": "1.0.0",
        "APP_BUILD_NUMBER": "18"
      },
      "distribution": "store",
      "developmentClient": false,
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    },
    "store-simulator": {
      "extends": "production",
      "distribution": "internal",
      "ios": { "simulator": true, "config": "store-screenshots.yml" },
      "channel": "store-simulator"
    },
    "store-capture-existing": {
      "extends": "store-simulator",
      "ios": { "simulator": true, "config": "capture-existing.yml" }
    },
    "store-capture-gallery": {
      "extends": "store-capture-existing",
      "ios": { "simulator": true, "config": "capture-gallery.yml" }
    },
    "e2e-ios-simulator": {
      "node": "24.15.0",
      "distribution": "internal",
      "environment": "development",
      "withoutCredentials": true,
      "ios": { "simulator": true },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_ORIGIN": "http://127.0.0.1:19100",
        "EXPO_PUBLIC_WS_ORIGIN": "ws://127.0.0.1:19200",
        "EXPO_PUBLIC_APP_ORIGIN": "http://127.0.0.1:19300",
        "EXPO_PUBLIC_ENABLE_FIXTURES": "false",
        "EXPO_PUBLIC_GUEST_ONLY": "false",
        "NPM_CONFIG_INSTALL_LINKS": "true"
      }
    },
    "beta": {
      "extends": "production",
      "env": {
        "APP_VERSION": "0.1.0",
        "APP_BUILD_NUMBER": "16"
      },
      "ios": {
        "simulator": false
      },
      "channel": "beta"
    }
  },
  "submit": {
    "production": {
      "android": {
        "applicationId": "com.yepwatch.app",
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      },
      "ios": {
        "bundleIdentifier": "com.yepwatch.app",
        "ascAppId": "6826403019",
        "appleTeamId": "QKFZC8CC8J"
      }
    },
    "beta": {
      "android": {
        "applicationId": "com.yepwatch.app",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "bundleIdentifier": "com.yepwatch.app",
        "ascAppId": "6826403019",
        "appleTeamId": "QKFZC8CC8J"
      }
    }
  }
}
