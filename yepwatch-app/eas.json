{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "24.15.0",
      "env": {
        "APP_VARIANT": "production",
        "APP_BUILD_NUMBER": "16",
        "EXPO_PUBLIC_API_ORIGIN": "https://yepwatch.com",
        "EXPO_PUBLIC_APP_ORIGIN": "https://yepwatch.com",
        "EXPO_PUBLIC_WS_ORIGIN": "wss://yepwatch.com",
        "EXPO_PUBLIC_ENABLE_FIXTURES": "false",
        "EXPO_PUBLIC_GUEST_ONLY": "false",
        "NPM_CONFIG_INSTALL_LINKS": "true"
      },
      "environment": "production"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "developmentClient": false,
      "env": {
        "APP_VARIANT": "preview"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "ios": {
        "simulator": true
      },
      "environment": "preview",
      "channel": "beta-preview"
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "developmentClient": false,
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    },
    "beta": {
      "extends": "production",
      "ios": {
        "simulator": false
      },
      "channel": "beta"
    }
  },
  "submit": {
    "beta": {
      "android": {
        "applicationId": "com.yepwatch.app",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "bundleIdentifier": "com.yepwatch.app",
        "ascAppId": "6826403019",
        "appleTeamId": "QKFZC8CC8J"
      }
    }
  }
}
