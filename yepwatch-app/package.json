{
  "name": "yepwatch-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@goodwatch/yepwatch-contracts": "file:../goodwatch-webapp/packages/yepwatch-contracts",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.16",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.9",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "export:web": "expo export --platform web --source-maps",
    "export:native": "expo export --platform ios --platform android --source-maps --output-dir dist-native",
    "check:resolution": "node scripts/check-resolution.cjs",
    "release:config": "node scripts/release-env.cjs config --type public",
    "release:web": "node scripts/release-env.cjs export --platform web --output-dir .expo/exports/beta-web-shared-r1 --clear",
    "release:preview:android": "python3 scripts/build-preview-android.py",
    "update:configure-env": "node scripts/configure-ota-env.cjs",
    "update:beta:ios": "npx eas-cli@latest update --channel beta --platform ios --environment production --input-dir .expo/updates/beta-ios",
    "update:beta:android": "npx eas-cli@latest update --channel beta-preview --platform android --environment preview --input-dir .expo/updates/beta-android"
  },
  "private": true
}
