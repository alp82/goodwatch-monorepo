# Public values only. Never put database, gateway, OAuth or room secrets here.
EXPO_PUBLIC_API_ORIGIN=https://yepwatch.com
# Native shared links use this public app host. Web defaults to its current app origin.
# EXPO_PUBLIC_APP_ORIGIN=https://yepwatch.com
# Default: same host as API, with wss. Override only for a local gateway.
# EXPO_PUBLIC_WS_ORIGIN=ws://127.0.0.1:4317
EXPO_PUBLIC_ENABLE_FIXTURES=false
# Optional prominent label for a synthetic development backend:
# EXPO_PUBLIC_DEVELOPMENT_NOTICE=Local POC: synthetic catalog and memory storage.
