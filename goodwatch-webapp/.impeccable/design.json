	"narrative": {
		"northStar": "The Lamp-Lit Shelf",
		"overview": "GoodWatch looks like a home video shelf in a dark room with a warm lamp on. The room is dark navy. The posters and backdrops are the color. Amber is the lamp: it marks actions, the current place, links, and awards. The interface stays out of the way so that people compare titles, not chrome.\n\nDensity is high but calm. Poster grids, score rows, and episode grids carry a lot of data, so surfaces stay flat, layers come from translucent white, and text steps down through a blue-gray ramp. Title pages take on the color of the title itself: the page sits on the title's own backdrop, blurred and darkened. Brand scenes, such as the start page room, the TV easter eggs, the intro film, and the footer cinema, are illustrated or pixel-art worlds with their own rules. They frame the app but don't set its controls.",
		"keyCharacteristics": [
			"Dark navy base for most pages; title pages tint toward their own backdrop.",
			"Amber as the brand light; open decision D7 settles its exact job.",
			"Translucent white layers (4-20%) and thin white rings instead of shadows.",
			"Pills for chips, toggles, and most buttons; 8-16px corners for cards, panels, fields, and action buttons.",
			"Gabarito for the brand and many page titles, the system sans for data and controls.",
			"An 11-step score scale that is the app's main data color, plus fixed colors for rating sources and the fingerprint."
		],
		"rules": [
			{
				"name": "The Score Owns Its Colors Rule",
				"body": "The score ramp means \"how good\". Don't use its reds and greens for status, errors, or decoration.",
				"section": "colors"
			},
			{
				"name": "The Readable Score Rule",
				"body": "White text on a score color uses the darkened tile color, not the raw ramp step. Score words on dark use the lightened text color.",
				"section": "colors"
			},
			{
				"name": "The Palette Means Something Rule",
				"body": "Each data palette (sources, fingerprint, moods, genres) appears only with the data it encodes. Don't borrow its colors for chrome.",
				"section": "colors"
			},
			{
				"name": "The Heavy Weights Rule",
				"body": "Hierarchy comes from weight (600-900) and size, not from color. Buttons use 700-900.",
				"section": "typography"
			},
			{
				"name": "The One Gabarito Source Rule",
				"body": "Gabarito is declared in `app/fonts/gabarito.css`. Don't add another inline `fontFamily` string for it; seven files already do.",
				"section": "typography"
			},
			{
				"name": "The Ring Before Shadow Rule",
				"body": "To separate a surface, add a 1px white ring at 10% first. Use a shadow only when the surface overlaps other content.",
				"section": "elevation"
			}
		],
		"dos": [
			"**Do** keep page backgrounds on Night, except title pages, which sit on their own darkened backdrop.",
			"**Do** build layers with white veils at 4-20% and 1px white rings at 10-15%.",
			"**Do** use pills for chips, toggles, and segmented controls.",
			"**Do** use the darkened tile color behind white score numbers.",
			"**Do** let posters and backdrops carry color.",
			"**Do** use the system sans for data, controls, and body text, with tabular figures for numbers.",
			"**Do** match the variant the surrounding page already uses wherever an open decision (D1 to D7) applies.",
			"**Do** animate only transform and opacity, and keep interface motion at 120-300ms.",
			"**Do** make every interactive element at least 40px tall on touch, with a visible focus ring."
		],
		"donts": [
			"**Don't** add a new variant of a button, selected state, page title, section heading, or eyebrow label. Pick from the ones listed here.",
			"**Don't** use the score ramp, rating source colors, fingerprint colors, or mood colors outside their data.",
			"**Don't** put white text on a raw light score color (scores 50-70).",
			"**Don't** introduce slate, stone, neutral, indigo, or blue for chrome. The neutral ramp is the blue-gray one, and the accent is amber.",
			"**Don't** use react-toastify's default light theme, the blue `Spinner`, or the `imports/shared.ts` indigo buttons as models. They're cleanup items.",
			"**Don't** use the raised gradient `Button` component in `app/ui/button/Button.tsx`, or the `primary-*`, `accent-*`, and `drop-shadow-neu*` theme tokens. They're unused leftovers.",
			"**Don't** add coverage or source disclaimers under data.",
			"**Don't** crop posters out of their 2:3 shape."
		]
	}
