+
+
+test("title details fail over a silent draining coordinator before their 3 s page deadline", async (t) => {
+ const { titleDetailsWithin } = await import("../server/title-page-budget.ts")
+ const received = await cluster(t, [
+  () => {},
+  (_, __, res) => answer(res),
+  (_, __, res) => answer(res),
+ ])
+ const work = query("WITH media_data AS (SELECT 1 AS n) SELECT n FROM media_data", [], { maxReadAttemptMs: 1000 })
+ try {
+  assert.deepEqual(await titleDetailsWithin(work), [{ n: 1 }])
+ } finally { await work.catch(() => {}) }
+ assert.deepEqual(received.map(host => host.length), [1, 1, 0])
+})
+
+test("a read attempt cap does not shorten a mutation or replay it", async (t) => {
+ const received = await cluster(t, [
+  (_, __, res) => setTimeout(() => answer(res), 100),
+  (_, __, res) => answer(res),
+ ])
+ await getCrateClient().execute("UPDATE saved SET n = n + 1", [], { maxReadAttemptMs: 20 })
+ assert.deepEqual(received.map(host => host.length), [1, 0])
+})
+
+
+test("the final coordinator retains the remaining read budget after capped attempts", async (t) => {
+ const received = await cluster(t, [
+  () => {},
+  () => {},
+  (_, __, res) => setTimeout(() => answer(res), 100),
+ ])
+ assert.deepEqual(await query("SELECT n", [], { maxReadAttemptMs: 20, timeoutMs: 1000 }), [{ n: 1 }])
+ assert.deepEqual(received.map(host => host.length), [1, 1, 1])
+})
