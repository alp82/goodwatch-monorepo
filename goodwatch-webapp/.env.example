TMDB_API_KEY=
# Optional exact public origin (scheme + host + port, no trailing slash).
# Defaults: production https://goodwatch.app, development http://localhost:3003.
# Set this for staging deployments or another development URL.
APP_ORIGIN=
TMDB_API_TOKEN=
OMDB_API_KEY=
REDIS_PASS=
REDIS_HOST=
REDIS_PORT=
CRATE_HOSTS=
CRATE_PORT=
CRATE_USER=
CRATE_PASS=
QDRANT_URL=
QDRANT_API_KEY=

# Shared with the Windmill f/utils/homepage_warmup_secret secret variable.
HOMEPAGE_WARMUP_SECRET=

# Combined search: reuse the existing Crate and Redis services.
TYPESAFE_API_KEY=
# Persistent 32-byte key as 64 hex characters. Keep stable across redeploys.
SEARCH_STORAGE_KEY=
# Optional; only use a header overwritten by trusted ingress, containing one IP.
SEARCH_TRUSTED_IP_HEADER=
# Translation is off by default; OPENROUTER_API_KEY is only needed when enabled.
SEARCH_TRANSLATION_ENABLED=false
OPENROUTER_API_KEY=

# Optional directory for the query model files (882 MB, downloaded on first use). Defaults to a temp directory.
# The Docker image sets it to /data/gw-search-models and holds the files there.
SEARCH_MODEL_DIR=
# Optional. Searches that may run at once in this process. One more gets a "busy" answer (503 with Retry-After).
# Defaults to 4.
SEARCH_MAX_IN_FLIGHT=
# Optional. Threads the query encoder computes with. Defaults to half the cores, at most 4.
SEARCH_ENCODER_THREADS=

# Recommendation experience feature flags (app/server/features.server.ts), set in Coolify.
# Read on every request: a container restart applies a change, no build needed. Unset or unknown means off (old pages).
# Stored taste vectors and match on cards: off, shadow or on.
REC_TASTE_MATCH=
# The rest take off, preview or on. Preview shows the feature only to the users in REC_PREVIEW_USERS.
# New filter bar and Discover page.
REC_FILTER_BAR=
# /watch-next and the Wishlist redirect.
REC_WATCH_NEXT=
# New Taste tabs.
REC_TASTE_PAGE=
# /explorer.
REC_EXPLORER=
# Dock, hub sheet, Browse panel and command palette.
REC_NAVIGATION=
# Age limit and content filter in the filter bar, and the rating badge on cards. Off also ignores age, hide and ok in
# URLs. It needs a title snapshot published with ratings; without them it stays hidden whatever this says.
REC_AGE_FILTER=
# Tracking. The movie watch log: once a movie is Seen its Seen button opens the log of its watches, where watches are
# added, dated and removed, and /api/watch-log answers. Episode tracking on a show page: the status box in the hero and
# the episode list, and /api/tracking/show answers. Off: Seen is the toggle it was, and the show page is as before.
REC_TRACKING=
# Supabase user ids that see features in preview, separated by commas.
REC_PREVIEW_USERS=
