TMDB_API_KEY=
# Optional exact public origin (scheme + host + port, no trailing slash).
# Defaults: production https://goodwatch.app, development http://localhost:3003.
# Set this for staging deployments or another development URL.
APP_ORIGIN=
TMDB_API_TOKEN=
OMDB_API_KEY=
REDIS_PASS=
REDIS_HOST=
REDIS_PORT=
CRATE_HOSTS=
CRATE_PORT=
CRATE_USER=
CRATE_PASS=
QDRANT_URL=
QDRANT_API_KEY=

# Shared with the Windmill f/utils/homepage_warmup_secret secret variable.
HOMEPAGE_WARMUP_SECRET=

# Combined search: reuse the existing Crate and Redis services.
TYPESAFE_API_KEY=
# Persistent 32-byte key as 64 hex characters. Keep stable across redeploys.
SEARCH_STORAGE_KEY=
# Optional; only use a header overwritten by trusted ingress, containing one IP.
SEARCH_TRUSTED_IP_HEADER=
# Translation is off by default; OPENROUTER_API_KEY is only needed when enabled.
SEARCH_TRANSLATION_ENABLED=false
OPENROUTER_API_KEY=

# Optional cache for the query model files (about 900 MB, downloaded on first use). Defaults to a temp directory.
SEARCH_MODEL_DIR=
