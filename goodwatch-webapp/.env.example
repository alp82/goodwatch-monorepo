TMDB_API_KEY=
# Optional exact public origin (scheme + host + port, no trailing slash).
# Defaults: production https://goodwatch.app; none in development, where search,
# poster impressions and og image warming answer 403 until it is set.
# Set this for staging deployments or another development URL.
APP_ORIGIN=
TMDB_API_TOKEN=
OMDB_API_KEY=
REDIS_PASS=
REDIS_HOST=
REDIS_PORT=
CRATE_HOSTS=
CRATE_PORT=
CRATE_USER=
CRATE_PASS=
QDRANT_URL=
QDRANT_API_KEY=

# Shared with the Windmill f/utils/homepage_warmup_secret secret variable.
HOMEPAGE_WARMUP_SECRET=

# Combined search: reuse the existing Crate and Redis services.
TYPESAFE_API_KEY=
# Persistent 32-byte key as 64 hex characters. Keep stable across redeploys.
SEARCH_STORAGE_KEY=
# Optional; only use a header overwritten by trusted ingress, containing one IP.
SEARCH_TRUSTED_IP_HEADER=
# Translation is off by default; OPENROUTER_API_KEY is only needed when enabled.
SEARCH_TRANSLATION_ENABLED=false
OPENROUTER_API_KEY=

# Optional directory for the query model files (882 MB, downloaded on first use). Defaults to a temp directory.
# The Docker image sets it to /data/gw-search-models and holds the files there.
SEARCH_MODEL_DIR=
# Optional. Searches that may run at once in this process. One more gets a "busy" answer (503 with Retry-After).
# Defaults to 4.
SEARCH_MAX_IN_FLIGHT=
# Optional. Threads the query encoder computes with. Defaults to half the cores, at most 4, and to 2 in the search role.
SEARCH_ENCODER_THREADS=
# Optional. What this process is: page (no search work), search (a search role), or both. Defaults to both.
# See docs/search-role.md.
WEBAPP_ROLE=


# "Talked about now" on title pages (app/server/talked-about-now/flags.server.ts), set in Coolify.
# off, preview or on; unset or unknown means off. Read on every request: a container restart applies a change.
TALKED_ABOUT_NOW_TITLE=
# "Talked about now" below the start page's room (#557), and /api/talked-about-now that it reads. Same values.
TALKED_ABOUT_NOW_ROW=
# Supabase user ids that see "Talked about now" in preview, separated by commas.
TALKED_ABOUT_NOW_PREVIEW_USERS=
# Optional. Matcher lanes of the social links to leave out, separated by commas (for example vector_context).
SOCIAL_DISABLED_LANES=

# Better Auth remains off until the coordinated auth + MCP cut-over (#536).
BETTER_AUTH_ENABLED=false
BETTER_AUTH_URL=
# Stable independent secrets, at least 32 characters each. Back them up.
BETTER_AUTH_SECRET=
# Permanent lookup-index root. Never rotate in place; see auth-maintenance.md.
AUTH_CRATEDB_ENCRYPTION_SECRET=
# Durable JSON key ring, stored as a secret. Independent random secrets >=32 chars.
# {"active":"2026-10","keys":{"2026-10":"<random secret>"},"allowLegacy":true}
AUTH_CRATEDB_ENCRYPTION_KEYS=
# Comma-separated HTTP origins on the private auth network; no URL credentials.
AUTH_CRATEDB_ORIGINS=
AUTH_CRATEDB_USERNAME=
AUTH_CRATEDB_PASSWORD=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Purelymail submission: smtp.purelymail.com:465 with implicit TLS.
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
# Required: One IP header overwritten by trusted ingress, never passed through.
AUTH_TRUSTED_IP_HEADER=

# Canonical external MCP URL; required with Better Auth enabled.
MCP_RESOURCE_URL=
