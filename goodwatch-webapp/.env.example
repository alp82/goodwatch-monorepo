TMDB_API_KEY=
# Optional exact public origin (scheme + host + port, no trailing slash).
# Defaults: production https://goodwatch.app; none in development, where search,
# poster impressions and og image warming answer 403 until it is set.
# Set this for staging deployments or another development URL.
APP_ORIGIN=
TMDB_API_TOKEN=
OMDB_API_KEY=
REDIS_PASS=
REDIS_HOST=
REDIS_PORT=
CRATE_HOSTS=
CRATE_PORT=
CRATE_USER=
CRATE_PASS=
QDRANT_URL=
QDRANT_API_KEY=

# Shared with the Windmill f/utils/homepage_warmup_secret secret variable.
HOMEPAGE_WARMUP_SECRET=

# Combined search: reuse the existing Crate and Redis services.
TYPESAFE_API_KEY=
# Persistent 32-byte key as 64 hex characters. Keep stable across redeploys.
SEARCH_STORAGE_KEY=
# Optional; only use a header overwritten by trusted ingress, containing one IP.
SEARCH_TRUSTED_IP_HEADER=
# Translation is off by default; OPENROUTER_API_KEY is only needed when enabled.
SEARCH_TRANSLATION_ENABLED=false
OPENROUTER_API_KEY=

# Optional directory for the query model files (882 MB, downloaded on first use). Defaults to a temp directory.
# The Docker image sets it to /data/gw-search-models and holds the files there.
SEARCH_MODEL_DIR=
# Optional. Searches that may run at once in this process. One more gets a "busy" answer (503 with Retry-After).
# Defaults to 4.
SEARCH_MAX_IN_FLIGHT=
# Optional. Threads the query encoder computes with. Defaults to half the cores, at most 4, and to 2 in the search role.
SEARCH_ENCODER_THREADS=
# Optional. What this process is: page (no search work), search (a search role), or both. Defaults to both.
# See docs/search-role.md.
WEBAPP_ROLE=

