[Unit]
Description=GoodWatch sanitized production search ingress evidence
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Environment=DOCKER_CONFIG=/opt/goodwatch-search-acceptance/docker-config
Environment=DOCKER_HOST=unix:///var/run/docker.sock
EnvironmentFile=/etc/default/goodwatch-search-ingress
ExecStart=/usr/bin/node /opt/goodwatch-search-acceptance/ingress-collect.mjs /var/lib/goodwatch-search-ingress ${SEARCH_INGRESS_REPLAY_FROM} ${SEARCH_INGRESS_HOST}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/goodwatch-search-ingress
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
