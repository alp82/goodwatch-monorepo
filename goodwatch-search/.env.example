# Copy to .env on the host, or let "./deploy.sh copy-env" write it from the running page instance. Never commit .env.
# Compose reads this file twice: for the two settings below, and as the environment of both search roles.
# Put a value that contains $, #, a quote, or a space in single quotes: Compose then takes it as it is.

# The registry image name of the webapp, without a tag: the image of the page instance on this host, as
# "docker ps" shows it.
SEARCH_IMAGE=
# The commit that the roles run: the image's tag, 40 characters. ./deploy.sh <commit> changes this line.
SEARCH_COMMIT=

# What a search role reads. The names are those of the webapp (goodwatch-webapp/.env.example), and the values are
# those of the page instances. "./deploy.sh copy-env" copies exactly the names that are set below.
# The search index, the history rows, and the reading store.
CRATE_HOSTS=
CRATE_PORT=
CRATE_USER=
CRATE_PASS=
# The vectors.
QDRANT_URL=
QDRANT_API_KEY=
# The cache cluster: the reading cache, the lock, the rate counters, the spending record, and the title snapshot.
REDIS_HOST=
REDIS_HOST2=
REDIS_HOST3=
REDIS_PORT=
REDIS_PASS=
# The session check. Members reach a search role directly.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The reading call, the key for stored searches, and the header that carries the visitor's address.
TYPESAFE_API_KEY=
SEARCH_STORAGE_KEY=
SEARCH_TRUSTED_IP_HEADER=
# The TMDB title search: the title lookup of a search, and what the command palette answers from while the index loads.
TMDB_API_KEY=
# The feature flags. The command palette answers 404 without REC_NAVIGATION, and the search route reads
# REC_FILTER_BAR. The rest keep a role's answers the same as a page instance's.
REC_NAVIGATION=
REC_FILTER_BAR=
REC_TASTE_MATCH=
REC_TASTE_PAGE=
REC_WATCH_NEXT=
REC_EXPLORER=
REC_AGE_FILTER=
REC_TRACKING=
REC_PREVIEW_USERS=

# Set by docker-compose.yml, so a line here has no effect: WEBAPP_ROLE, SEARCH_MAX_IN_FLIGHT, SOURCE_COMMIT, HOST,
# PORT, METRICS_PORT.
# Set by the image: NODE_ENV, SEARCH_MODEL_DIR (the query models are in the image).
# Optional, and not set on the page instances: SEARCH_ENCODER_THREADS (a role's default is 2, and the smoke check
# fails on another count), APP_ORIGIN, SEARCH_TRANSLATION_ENABLED with OPENROUTER_API_KEY.
