# Local-only development. Never put database/catalog/account credentials here.
YEPWATCH_REALTIME_HOST=127.0.0.1
YEPWATCH_REALTIME_PORT=4311
YEPWATCH_API_ORIGIN=http://127.0.0.1:3000
# Set locally to the SAME >=32-character service credential used by YepWatch API.
# No default credential. Do not commit .env or place this in Expo EXPO_PUBLIC_*.
YEPWATCH_GATEWAY_SECRET=
YEPWATCH_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Standalone disposable development Valkey. Separate subscriber connection.
YEPWATCH_VALKEY_URL=redis://127.0.0.1:46379
# Cluster alternative: uses ioredis public master discovery and global Pub/Sub.
# YEPWATCH_VALKEY_NODES=[{"host":"127.0.0.1","port":7000},{"host":"127.0.0.1","port":7001},{"host":"127.0.0.1","port":7002}]
# YEPWATCH_VALKEY_USER=
# YEPWATCH_VALKEY_PASSWORD=
