# Separate loopback process; keep legacy rooms/gateways running.
YEPWATCH_CONTINUOUS=1
YEPWATCH_REALTIME_HOST=127.0.0.1
YEPWATCH_REALTIME_PORT=4321
YEPWATCH_API_ORIGIN=http://127.0.0.1:15994
YEPWATCH_ALLOWED_ORIGINS=http://127.0.0.1:8131
YEPWATCH_VALKEY_URL=redis://127.0.0.1:46398
# Independent API service bearer, >=32 characters; provide privately, never commit.
# Gateway must NEVER receive Crate/catalog/account credentials.
YEPWATCH_GATEWAY_SECRET=
