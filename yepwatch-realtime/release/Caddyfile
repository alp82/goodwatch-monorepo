{
  admin off
  auto_https off
  persist_config off
  grace_period 10s
}
:8080 {
  root * /srv
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
  request_body {
    max_size 64KB
  }
  # Exclusive handlers prevent internal/unknown API paths reaching SPA fallback.
  @internal path /api/yepwatch/v1/proposal/realtime/internal /api/yepwatch/v1/proposal/realtime/internal/* /api/yepwatch/v1/proposal/realtime/health
  handle @internal {
    respond "Not found" 404
  }
  # Held requests try the restarted service every 100 ms: at 500 ms a phone stayed cut off up to half a second
  # after the service was back, which pushed a 2.7 s restart past the 3 s quiet period (owner rule Q24a).
  handle /api/yepwatch/v1/proposal/realtime {
    reverse_proxy gateway:4311 {
      lb_try_duration 30s
      lb_try_interval 100ms
      stream_close_delay 30s
    }
  }
  @read {
    method GET
    path /api/yepwatch/v1/proposal/catalog/metadata /api/yepwatch/v1/proposal/health/live /api/yepwatch/v1/proposal/health/ready
  }
  handle @read {
    reverse_proxy api:3000 {
      # During a deploy the api restarts: hold the request and retry instead of failing it.
      lb_try_duration 30s
      lb_try_interval 100ms
    }
  }
  @snapshot {
    method GET
    path_regexp snapshot ^/api/yepwatch/v1/proposal/rooms/[A-Za-z0-9_-]{1,256}$
  }
  handle @snapshot {
    reverse_proxy api:3000 {
      # During a deploy the api restarts: hold the request and retry instead of failing it.
      lb_try_duration 30s
      lb_try_interval 100ms
    }
  }
  @admission {
    method POST
    path /api/yepwatch/v1/proposal/rooms /api/yepwatch/v1/proposal/guest/resolve-invite /api/yepwatch/v1/proposal/invites/preview
  }
  handle @admission {
    reverse_proxy api:3000 {
      # During a deploy the api restarts: hold the request and retry instead of failing it.
      lb_try_duration 30s
      lb_try_interval 100ms
    }
  }
  @commands {
    method POST
    path_regexp command ^/api/yepwatch/v1/proposal/rooms/[A-Za-z0-9_-]{1,256}/(join|resume|archive|commands|preview|realtime-ticket|member/link|deletion|restore)$
  }
  handle @commands {
    reverse_proxy api:3000 {
      # During a deploy the api restarts: hold the request and retry instead of failing it.
      lb_try_duration 30s
      lb_try_interval 100ms
    }
  }
  @member_callback {
    method GET
    path /api/yepwatch/v1/proposal/member/callback
  }
  handle @member_callback {
    reverse_proxy api:3000 {
      # During a deploy the api restarts: hold the request and retry instead of failing it.
      lb_try_duration 30s
      lb_try_interval 100ms
    }
  }
  @member_write {
    method POST
    path /api/yepwatch/v1/proposal/member/start /api/yepwatch/v1/proposal/member/exchange /api/yepwatch/v1/proposal/account/start /api/yepwatch/v1/proposal/account/exchange /api/yepwatch/v1/proposal/account/logout /api/yepwatch/v1/proposal/account/deletion /api/yepwatch/v1/proposal/account/restore
  }
  handle @member_write {
    reverse_proxy api:3000 {
      # During a deploy the api restarts: hold the request and retry instead of failing it.
      lb_try_duration 30s
      lb_try_interval 100ms
    }
  }
  @member_read {
    method GET
    path_regexp member ^/api/yepwatch/v1/proposal/(rooms/[A-Za-z0-9_-]{1,256}/member(/progress)?|account(/home|/deletion)?)$
  }
  handle @member_read {
    reverse_proxy api:3000 {
      # During a deploy the api restarts: hold the request and retry instead of failing it.
      lb_try_duration 30s
      lb_try_interval 100ms
    }
  }
  # Link-preview card for a room invite (og:image of /r/<code>).
  @invite_card {
    method GET HEAD
    path_regexp invite_card ^/api/yepwatch/v1/proposal/invites/[A-Za-z0-9._-]{1,200}/card\.png$
  }
  handle @invite_card {
    reverse_proxy api:3000 {
      lb_try_duration 30s
      lb_try_interval 100ms
    }
  }
  @unknown_api path /api /api/*
  handle @unknown_api {
    respond "Not found" 404
  }
  # Association files must return actual JSON or404, never index.html.
  handle /.well-known/* {
    header Content-Type application/json
    header Cache-Control "public, max-age=300"
    file_server
  }
  # Immutable files ship precompressed at the highest levels (yepwatch-app/scripts/invite-page.cjs): ~25% fewer
  # bytes than on-the-fly zstd on the way to a fresh browser's first screen. Files without them are encoded as before.
  handle /_expo/* {
    header Cache-Control "public, max-age=31536000, immutable"
    file_server {
      precompressed br zstd gzip
    }
  }
  handle /assets/* {
    header Cache-Control "public, max-age=31536000, immutable"
    file_server {
      precompressed br zstd gzip
    }
  }
  handle /downloads/* {
    @apk path *.apk
    header @apk Content-Type application/vnd.android.package-archive
    header Cache-Control "public, max-age=3600"
    file_server
  }
  handle /link-card.png {
    header Cache-Control "public, max-age=86400"
    file_server
  }
  @legal path /privacy /support /terms
  handle @legal {
    rewrite * {path}.html
    header Cache-Control "public, max-age=300"
    file_server
  }
  # Room invite links: the app page with link-preview tags for this invite (scripts/invite-page.cjs).
  @invite_page {
    method GET HEAD
    path_regexp invite_page ^/r/[A-Za-z0-9._-]{1,200}$
  }
  handle @invite_page {
    rewrite * /invite.html
    header Cache-Control no-store
    templates {
      mime text/html
      between [[ ]]
    }
    file_server
  }
  handle {
    route {
      try_files {path} /index.html
      header Cache-Control no-store
      file_server
    }
  }
}
