# Private runtime file: copy to /srv/yepwatch/secrets/api.env (0600).
# Passwords are separate files mounted by compose.yaml. No dotenv build inputs.
YEPWATCH_PROPOSAL_PUBLIC_ORIGIN=https://yepwatch.com
YEPWATCH_PROPOSAL_CRATEDB_ORIGIN=http://10.0.0.11:4200
YEPWATCH_PROPOSAL_CRATEDB_USERNAME=yepwatch_runtime
YEPWATCH_PROPOSAL_KEY_ID=yepwatch-first-release-01
YEPWATCH_PROPOSAL_MAX_ACTIVE_ROOMS=20
YEPWATCH_PROPOSAL_ADMISSIONS_PER_MINUTE=20
YEPWATCH_PROPOSAL_COMMANDS_PER_MINUTE=600
YEPWATCH_PROPOSAL_ACTOR_COMMANDS_PER_MINUTE=60
CRATE_HOSTS=10.0.0.11,10.0.0.12,10.0.0.13
CRATE_PORT=4200
CRATE_USER=yepwatch_catalog
REDIS_HOST=10.0.0.14
REDIS_HOST2=10.0.0.15
REDIS_HOST3=10.0.0.16
REDIS_PORT=6379
# Enable only after the existing GoodWatch issuer/client and resource are configured.
YEPWATCH_MEMBER_ENABLED=true
YEPWATCH_MEMBER_ISSUER_ORIGIN=https://goodwatch.app
AUTH_YEPWATCH_RESOURCE=https://yepwatch.com/api/yepwatch
AUTH_YEPWATCH_CLIENT_ID=REPLACE_WITH_REGISTERED_PUBLIC_CLIENT_ID
AUTH_YEPWATCH_REDIRECT_URIS=https://yepwatch.com/api/yepwatch/v1/proposal/member/callback
