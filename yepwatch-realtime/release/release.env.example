# Nonsecret metadata only. Actual private files stay outside the checkout.
YEPWATCH_SOURCE_COMMIT=REVIEWED_FULL_COMMIT
YEPWATCH_FRONT_IMAGE=yepwatch-front:RELEASE_ID
YEPWATCH_API_IMAGE=yepwatch-api:RELEASE_ID
YEPWATCH_GATEWAY_IMAGE=yepwatch-gateway:RELEASE_ID
YEPWATCH_API_ENV_FILE=/srv/yepwatch/secrets/api.env
YEPWATCH_GATEWAY_SECRET_FILE=/srv/yepwatch/secrets/gateway-service
YEPWATCH_FANOUT_PASSWORD_FILE=/srv/yepwatch/secrets/fanout-password
YEPWATCH_ROOM_KEY_FILE=/srv/yepwatch/secrets/room-key
YEPWATCH_ROOM_PASSWORD_FILE=/srv/yepwatch/secrets/room-password
YEPWATCH_REVISION_URL_FILE=/srv/yepwatch/secrets/revision-url
YEPWATCH_CATALOG_PASSWORD_FILE=/srv/yepwatch/secrets/catalog-password
YEPWATCH_CATALOG_CACHE_PASSWORD_FILE=/srv/yepwatch/secrets/catalog-cache-password
# Used only with compose.local.yaml; choose an unused port, never retained ports.
YEPWATCH_REHEARSAL_PORT=18443
