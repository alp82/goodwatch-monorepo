logging {
  level  = "info"
  format = "logfmt"
}

// 1. Scrape the separate node_exporter container
prometheus.scrape "node" {
  targets = [
    {"__address__" = "node-exporter:9100"},
  ]
  forward_to = [prometheus.relabel.trim_node_metrics.receiver]

  // Add this line for better scrape monitoring:
  extra_metrics = true

  // Optional: You could uncomment and adjust these if needed later
  scrape_interval = "10s"
  scrape_timeout = "5s"
  // job_name = "node_exporter"
}

// 2. Drop node series that nobody reads, to stay under the active series
// limit of the Grafana Cloud tenant. Delete a rule to get its series back.
prometheus.relabel "trim_node_metrics" {
  forward_to = [prometheus.relabel.add_instance_label.receiver]

  // Per-collector scrape bookkeeping, and node_exporter's own Go runtime and
  // HTTP handler metrics. process_* stays.
  rule {
    action        = "drop"
    source_labels = ["__name__"]
    regex         = "node_scrape_collector_.*|go_.*|promhttp_.*"
  }

  // Per-CPU detail beyond node_cpu_seconds_total, which stays per core and mode.
  rule {
    action        = "drop"
    source_labels = ["__name__"]
    regex         = "node_cpu_guest_seconds_total|node_softnet_.*|node_schedstat_.*|node_cooling_device_.*"
  }

  // Virtual network interfaces: Docker veth pairs and bridges, and loopback.
  // Physical, WireGuard and Tailscale interfaces stay.
  rule {
    action        = "drop"
    source_labels = ["__name__", "device"]
    regex         = "node_network_.*;(veth.*|br-.*|docker.*|lo)"
  }

  // Pseudo and container filesystems. Real mounts such as /, /boot/efi and
  // the backup mounts stay.
  rule {
    action        = "drop"
    source_labels = ["__name__", "fstype"]
    regex         = "node_filesystem_.*;(tmpfs|devtmpfs|overlay|squashfs|nsfs|shm|ramfs)"
  }

  rule {
    action        = "drop"
    source_labels = ["__name__", "mountpoint"]
    regex         = "node_filesystem_.*;(/run|/var/lib/docker)(/.*)?"
  }

  // Virtual CD-ROM, loop and RAM block devices.
  rule {
    action        = "drop"
    source_labels = ["__name__", "device"]
    regex         = "node_disk_.*;(sr|loop|ram)\\d+"
  }
}

// 3. Relabel the scraped metrics before sending them
prometheus.relabel "add_instance_label" {
  // Forward relabeled metrics to the remote_write component's receiver
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  // Rule to add the 'instance' label using the value from the environment variable.
  // This rule uses __address__ (which always exists after scraping) as an anchor
  // to ensure the rule always runs, then replaces/adds the 'instance' label.
  rule {
    action       = "replace"
    source_labels = ["__address__"] // Anchor label, value doesn't matter here
    target_label = "instance"       // The label we want to create/set
    replacement  = env("VPS_INSTANCE_NAME") // The value for the instance label
  }

  rule {
      action        = "replace"
      source_labels = ["instance"]
      target_label  = "host"
    }

  rule {
    action       = "replace"
    target_label = "job"
    replacement  = "vps_node_metrics"
  }
}

// 4. Send relabeled metrics to Grafana Cloud Prometheus Remote Write endpoint.
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_CLOUD_PROM_URL")
    basic_auth {
      username = env("GRAFANA_CLOUD_PROM_USER")
      password = env("GRAFANA_CLOUD_PROM_PASSWORD")
    }
  }
}