// Loaded only on hosts that run a webapp instance, by the Compose override. Each host's Alloy scrapes the instance
// on its own coolify network. VPS_INSTANCE_NAME in .env becomes the instance and host labels, which tell the
// instances apart.
prometheus.scrape "webapp" {
	targets         = [{"__address__" = coalesce(env("WEBAPP_METRICS_TARGET"), "goodwatch-webapp:9464")}]
	scrape_interval = "15s"
	scrape_timeout  = "5s"
	metrics_path    = "/metrics"
	forward_to      = [prometheus.relabel.webapp.receiver]
}

prometheus.relabel "webapp" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	rule {
		target_label = "job"
		replacement  = "goodwatch_webapp"
	}

	rule {
		target_label = "instance"
		replacement  = env("VPS_INSTANCE_NAME")
	}

	rule {
		target_label = "host"
		replacement  = env("VPS_INSTANCE_NAME")
	}
}
