{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "goodwatch dev",
			"type": "shell",
			"options": {
				"shell": { "executable": "bash", "args": ["-c"] },
				"cwd": "${workspaceFolder}/goodwatch-webapp"
			},
			"command": "trap : INT; npm run dev; exec fish",
			"isBackground": true,
			"runOptions": { "runOn": "folderOpen" },
			"presentation": {
				"group": "services",
				"panel": "dedicated"
			},
			"problemMatcher": []
		}
	]
}
