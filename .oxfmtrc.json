{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 100,
	"semi": false,
	"singleQuote": false,
	"sortImports": false,
	"sortPackageJson": false,
	"ignorePatterns": [
		"**/node_modules/**",
		"**/.venv/**",
		"**/build/**",
		"**/dist/**",
		"**/public/**",
		"**/results/**",
		"**/artifacts/**",
		"**/package-lock.json"
	]
}
