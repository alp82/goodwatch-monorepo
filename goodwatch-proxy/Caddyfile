{
	servers :8480 {
		# abio's Traefik sets X-Forwarded-For and X-Forwarded-Proto; keep them instead of replacing them.
		trusted_proxies static 10.0.0.21/32
	}
}
a.goodwatch.app {
  header {
    Access-Control-Allow-Origin https://goodwatch.app
  }
  handle /static {
    reverse_proxy https://eu-assets.i.posthog.com:443 {
      header_up Host eu-assets.i.posthog.com
      header_down -Access-Control-Allow-Origin
    }
  }
  handle {
    reverse_proxy https://eu.i.posthog.com:443 {
      header_up Host eu.i.posthog.com
      header_down -Access-Control-Allow-Origin
    }
  }
}
status.goodwatch.app {
  @home {
    method GET HEAD
    path /
  }
  handle @home {
    redir * /status/services 302
  }
  # Public Kuma page only. Administration (including Socket.IO) is private.
  @public_status {
    method GET HEAD
    path /status/services /status/services/ /api/status-page/services /api/status-page/heartbeat/services /api/status-page/services/manifest.json /assets/* /upload/* /favicon.ico /icon.svg /icon.png /icon-192x192.png /icon-512x512.png /apple-touch-icon.png /apple-touch-icon-precomposed.png /manifest.json
  }
  handle @public_status {
    reverse_proxy http://10.0.0.10:4801
  }
  handle {
    respond "Not found" 404
  }
}
